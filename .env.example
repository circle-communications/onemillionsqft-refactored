# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server only (never prefix with NEXT_PUBLIC_). Used by /api/* routes to store leads.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public site origin, used for canonical URLs and sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lead emails (enquiry, contact, post-property, newsletter). Leads are always saved to the database;
# if any of these four is missing, no email is sent (a warning is logged).
# Gmail example: turn on 2-step verification, create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=developer.circlecommunications@gmail.com
SMTP_PASS=YOUR-16-CHAR-APP-PASSWORD
# Optional display name + address; defaults to SMTP_USER. Gmail rewrites other addresses to SMTP_USER.
MAIL_FROM="OneMillionSqFt <developer.circlecommunications@gmail.com>"
# Where notifications are delivered (comma separated for several)
LEADS_TO_EMAIL=developer.circlecommunications@gmail.com
